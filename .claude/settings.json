{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Read",
      "Edit(**/*.html)",
      "Edit(**/*.css)",
      "Edit(**/*.ts)",
      "Edit(**/*.tsx)",
      "Edit(**/*.js)",
      "Edit(**/*.md)",
      "Bash(git status)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(ls*)",
      "Bash(find*)",
      "Bash(grep*)"
    ],
    "ask": [
      "Edit(.github/workflows/**)",
      "Edit(CNAME)",
      "Edit(robots.txt)",
      "Edit(sitemap.xml)",
      "Edit(package.json)",
      "Edit(vite.config.*)",
      "Edit(tailwind.config.*)",
      "Edit(tsconfig*.json)",
      "Bash(git mv*)",
      "Bash(rm*)",
      "Bash(mv*)",
      "Bash(git config user.email*)",
      "Bash(git config --global user.email*)"
    ],
    "deny": [
      "Read(.env)",
      "Read(.env.*)",
      "Bash(curl*)"
    ]
  }
}
